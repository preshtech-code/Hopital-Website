# Public Turnstile site key. Cloudflare provides test keys for local development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secrets. Configure these in Sites, never commit production values.
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
APPOINTMENTS_TO_EMAIL=appointments@example-hospital.com
MAIL_FROM_EMAIL=St. Peter's Hospital <website@example-hospital.com>
